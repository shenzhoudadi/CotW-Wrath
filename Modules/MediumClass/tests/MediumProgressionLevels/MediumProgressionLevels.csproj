<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <!-- Overridable so the same program can run against the 0.3.3 sources as a negative control. -->
    <ProductionProgression Condition="'$(ProductionProgression)' == ''">../../Medium/MediumProgression.cs</ProductionProgression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <Compile Include="$(ProductionProgression)" Link="Production/MediumProgression.cs" />
    <Compile Include="../../Medium/MediumProgressionMigration.cs" Link="Production/MediumProgressionMigration.cs" />
    <Compile Include="../../Utilities/Guids.cs" Link="Production/Guids.cs" />
  </ItemGroup>
</Project>
