<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <ProductionSurgeComponent Condition="'$(ProductionSurgeComponent)' == ''">../../Medium/NewComponents/AbilitySpecific/MediumSpiritSurgeComponent.cs</ProductionSurgeComponent>
    <ProductionSurgeMath Condition="'$(ProductionSurgeMath)' == ''">../../Medium/SpiritSurgeMath.cs</ProductionSurgeMath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Medium/MarshalSpiritRules.cs" Link="Production/MarshalSpiritRules.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="$(ProductionSurgeComponent)" Link="Production/MediumSpiritSurgeComponent.cs" />
    <Compile Include="$(ProductionSurgeMath)" Link="Production/SpiritSurgeMath.cs" />
    <Compile Include="../../Medium/SpiritSurgeReport.cs" Link="Production/SpiritSurgeReport.cs" />
    <Compile Include="../../Utilities/Guids.cs" Link="Production/Guids.cs" />
  </ItemGroup>
</Project>
