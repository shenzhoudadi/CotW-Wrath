<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <UseGameHarmonyReference>true</UseGameHarmonyReference>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CallOfTheWild.Wrath.Prototype</AssemblyName>
    <RootNamespace>CallOfTheWild.Wrath.Prototype</RootNamespace>
    <Version>0.14.65</Version>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WrathPath Condition="'$(WrathPath)' == ''">$(WOTR_GAME_PATH)</WrathPath>
    <GameManaged>$(WrathPath)\Wrath_Data\Managed</GameManaged>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <!-- The bundled module builds against a publicized reference. Never let
         its intermediate DLLs enter this project's reference candidate set. -->
    <None Remove="Modules\**" />
    <EmbeddedResource Remove="Modules\**" />
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="assets/Slimy.png" LogicalName="CotW.Slimy.png" />
    <EmbeddedResource Include="assets/ElongatedFingers.png" LogicalName="CotW.ElongatedFingers.png" />
    <Compile Include="Shared/HarmonyRuntimeCompatibility.cs" />
    <EmbeddedResource Include="assets\SpiritCall.png" LogicalName="CotW.SpiritCall.png" />
    <EmbeddedResource Include="assets\FontOfSpiritMagic.png" LogicalName="CotW.FontOfSpiritMagic.png" />
    <EmbeddedResource Include="assets\WallOfNausea.png" LogicalName="CotW.WallOfNausea.png" />
    <EmbeddedResource Include="assets\RighteousVigor.png" LogicalName="CotW.RighteousVigor.png" />
    <EmbeddedResource Include="assets\PathOfGlory.png" LogicalName="CotW.PathOfGlory.png" />
    <EmbeddedResource Include="assets\ForcefulStrike.png" LogicalName="CotW.ForcefulStrike.png" />
    <EmbeddedResource Include="assets\AuraOfDoom.png" LogicalName="CotW.AuraOfDoom.png" />
    <EmbeddedResource Include="assets\IrresistibleDance.png" LogicalName="CotW.IrresistibleDance.png" />
    <EmbeddedResource Include="assets\Metamixing.png" LogicalName="CotW.Metamixing.png" />
    <EmbeddedResource Include="assets\SavageMaw.png" LogicalName="CotW.SavageMaw.png" />
    <EmbeddedResource Include="assets\BloodArmor.png" LogicalName="CotW.BloodArmor.png" />
    <EmbeddedResource Include="assets\WardingWeapon.png" LogicalName="CotW.WardingWeapon.png" />
    <EmbeddedResource Include="assets\DivideMind.png" LogicalName="CotW.DivideMind.png" />
    <EmbeddedResource Include="assets\Invigorate.png" LogicalName="CotW.Invigorate.png" />
    <EmbeddedResource Include="assets\HowlingAgony.png" LogicalName="CotW.HowlingAgony.png" />
    <EmbeddedResource Include="assets\LocateWeakness.png" LogicalName="CotW.LocateWeakness.png" />
    <EmbeddedResource Include="assets\HaltUndead.png" LogicalName="CotW.HaltUndead.png" />
    <EmbeddedResource Include="assets\ControlUndead.png" LogicalName="CotW.ControlUndead.png" />
    <EmbeddedResource Include="assets\Silence.png" LogicalName="CotW.Silence.png" />
    <EmbeddedResource Include="assets\ForceSword.png" LogicalName="CotW.ForceSword.png" />
    <EmbeddedResource Include="assets\TemporalStasis.png" LogicalName="CotW.TemporalStasis.png" />
    <EmbeddedResource Include="assets\FlameArrow.png" LogicalName="CotW.FlameArrow.png" />
    <EmbeddedResource Include="assets\Rebuke.png" LogicalName="CotW.Rebuke.png" />
    <EmbeddedResource Include="assets\GhostbaneDirge.png" LogicalName="CotW.GhostbaneDirge.png" />
    <EmbeddedResource Include="assets\HWUnholy.png" LogicalName="CotW.HWUnholy.png" />
    <EmbeddedResource Include="assets\HWAnarchic.png" LogicalName="CotW.HWAnarchic.png" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GameManaged)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(GameManaged)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="assets/ArtfulDodge.png" LogicalName="CotW.ArtfulDodge.png" />
    <EmbeddedResource Include="assets/OsyluthGuile.png" LogicalName="CotW.OsyluthGuile.png" />
    <Reference Include="Owlcat.Runtime.Core"><HintPath>$(GameManaged)\Owlcat.Runtime.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Owlcat.Runtime.Validation"><HintPath>$(GameManaged)\Owlcat.Runtime.Validation.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UniRx"><HintPath>$(GameManaged)\UniRx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Owlcat.Runtime.UI"><HintPath>$(GameManaged)\Owlcat.Runtime.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireLocalGame" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')" Text="Set WOTR_GAME_PATH or pass -p:WrathPath=... to the installed Wrath game directory." />
  </Target>
