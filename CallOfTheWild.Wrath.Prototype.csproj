  <EmbeddedResource Include="assets/BrokenWingGambit.png" LogicalName="CotW.BrokenWingGambit.png" />
  <EmbeddedResource Include="assets/WoundedPawGambit.png" LogicalName="CotW.WoundedPawGambit.png" />
