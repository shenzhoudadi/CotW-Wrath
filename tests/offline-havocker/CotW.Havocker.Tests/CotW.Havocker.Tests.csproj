<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Old output contains transitive raw Unity DLLs from the mod reference.
         Use a clean probing directory; the offline resolver owns game loading. -->
    <OutputPath>$(WotrTestingRepositoryRoot)artifacts/bin/CotW.Havocker.Tests/$(Configuration)-isolated/</OutputPath>
    <WotrHarmony>game</WotrHarmony>
    <WotrModAssembly>$(MSBuildThisFileDirectory)../../artifacts/bin/CotW.Havocker.Adapter/$(Configuration)/net48/CotW.Havocker.Adapter.dll</WotrModAssembly>
  </PropertyGroup>
  <Import Project="../../src/WotR.Testing.Offline/build/WotR.Testing.Offline.targets" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../../src/WotR.Testing.Offline/WotR.Testing.Offline.csproj" />
    <ProjectReference Include="../CotW.Havocker.Adapter/CotW.Havocker.Adapter.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="CallOfTheWild.Wrath.Prototype"><HintPath>$(CotwAssembly)</HintPath><Private>true</Private></Reference>
    <Reference Include="Owlcat.Runtime.Validation"><HintPath>$(WotrManaged)/Owlcat.Runtime.Validation.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(WotrManaged)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <!-- Local optional compatibility probes only. No installation or game launch;
       the offline host loads real providers from their existing legal fixtures.
       These switches are off for the isolated Havocker mechanism slice. -->
  <ItemGroup Condition="'$(HavockerTttProbe)'=='true'">
    <WotrDependencyMod Include="D:/CodexProjects/CotW-Wrath/work/repair01440/dependencies/TabletopTweaks-Core/TabletopTweaks-Core/TabletopTweaks-Core.dll" />
    <WotrDependencyMod Include="D:/CodexProjects/CotW-Wrath/work/repair01440/dependencies/TabletopTweaks-Base/TabletopTweaks-Base/TabletopTweaks-Base.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(HavockerDarkCodexProbe)'=='true'">
    <WotrDependencyMod Include="D:/CodexProjects/CotW-Wrath/work/psychic01458/dependencies/DarkCodex/release/DarkCodex/DarkCodex.dll" />
  </ItemGroup>
  <Target Name="RequireCotwSlice" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(CotwAssembly)')" Text="Set CotwAssembly to the freshly compiled CotW DLL. No installed mod or game launch is needed." />
  </Target>
  <Target Name="KeepGameDependenciesCompileOnly" AfterTargets="ResolveAssemblyReferences">
    <PropertyGroup><_HavockerManagedPrefix>$([System.IO.Path]::GetFullPath('$(WotrManaged)'))\</_HavockerManagedPrefix></PropertyGroup>
    <ItemGroup>
      <!-- Private=false on direct game refs does not suppress transitive Unity
           dependencies discovered through the Private=true CotW reference. -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.FullPath)').StartsWith('$(_HavockerManagedPrefix)'))" />
    </ItemGroup>
  </Target>
</Project>
